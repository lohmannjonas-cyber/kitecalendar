generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  user_submitted
  crawled
  admin_created
}

enum ReviewStatus {
  pending
  approved
  rejected
  duplicate
}

enum UserRole {
  admin
}

model Event {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  description      String
  startDate        DateTime
  endDate          DateTime
  country          String
  region           String?
  city             String
  spotName         String?
  latitude         Float
  longitude        Float
  eventTypeId      String
  eventType        EventType    @relation(fields: [eventTypeId], references: [id])
  organizerName    String
  organizerWebsite String?
  sourceUrl        String?
  sourceType       SourceType
  reviewStatus     ReviewStatus @default(pending)
  featured         Boolean      @default(false)
  locationId       String?
  location         Location?    @relation(fields: [locationId], references: [id])
  crawlSourceId    String?
  crawlSource      CrawlSource? @relation(fields: [crawlSourceId], references: [id])
  brands           EventBrand[]
  forecasts        Forecast[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([reviewStatus, startDate])
  @@index([country, city])
  @@index([sourceUrl])
}

model Location {
  id        String  @id @default(cuid())
  country   String
  region    String?
  city      String
  spotName  String?
  latitude  Float
  longitude Float
  events    Event[]

  @@unique([country, region, city, spotName])
}

model Brand {
  id        String       @id @default(cuid())
  name      String       @unique
  website   String?
  color     String?
  isActive  Boolean      @default(true)
  events    EventBrand[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model EventBrand {
  eventId String
  brandId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  brand   Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([eventId, brandId])
}

model EventType {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  color     String?
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventSubmission {
  id               String       @id @default(cuid())
  title            String
  description      String
  startDate        DateTime
  endDate          DateTime
  country          String
  region           String?
  city             String
  spotName         String?
  latitude         Float?
  longitude        Float?
  eventTypeSlug    String
  organizerName    String
  organizerWebsite String?
  brandNames       String[]
  contactEmail     String
  sourceUrl        String?
  sourceType       SourceType
  reviewStatus     ReviewStatus @default(pending)
  duplicateOfId    String?
  reviewerNote     String?
  crawledAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([reviewStatus, createdAt])
  @@index([sourceUrl])
}

model CrawlSource {
  id              String   @id @default(cuid())
  name            String
  baseUrl         String   @unique
  sourceType      String
  robotsCheckedAt DateTime?
  termsNote       String?
  isActive        Boolean  @default(true)
  lastCrawledAt   DateTime?
  events          Event[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Forecast {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  forecastDate  DateTime
  averageKnots  Float
  gustKnots     Float
  direction     String
  rating        String
  provider      String
  rawPayload    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([eventId, forecastDate, provider])
  @@index([forecastDate])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(admin)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AlertSubscription {
  id          String   @id @default(cuid())
  email       String
  country     String?
  brandNames  String[]
  minRating   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([country])
}
